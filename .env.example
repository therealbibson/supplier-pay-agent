# Agent (taker) wallet — a dedicated wallet holding only what a payout needs.
# NEVER commit this file. Never reuse a wallet that holds other funds.
TAKER_PRIVATE_KEY=0x...

# Celo RPC (default: Forno public endpoint — works but slow, ~7s a call.
# The hackathon includes 3 months of Chainstack's Growth Plan free;
# use that RPC URL here for a faster demo if you claim it.)
RPC_URL=https://forno.celo.org

# Textile FX partner API key (optional). Without it, quotes work keyless
# with a TakerControl signature from the taker wallet.
TEXTILE_API_KEY=

# Loops House attribution tag assigned at registration.
# Use verbatim — do not re-derive it. Verify on-chain after the first
# tagged transaction with `verifyTx`.
ATTRIBUTION_TAG=celo_7f040b6e9d4f

# ERC-8004 agent identity (filled in after `npm run register-agent`)
AGENT_ID=
AGENT_URI=https://raw.githubusercontent.com/therealbibson/supplier-pay-agent/main/public/agent.json

# Set to "true" to allow mainnet execution. Without it the agent only
# previews quotes and refuses to send transactions.
CONFIRM_MAINNET=false
